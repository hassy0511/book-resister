# Firebase コンソール > プロジェクトの設定 > マイアプリ（ウェブアプリ）の値を入れる
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# `npm run gen:vapid` で作った Public Key（Private Key は GitHub Secrets にだけ入れる）
VITE_VAPID_PUBLIC_KEY=
# 任意。Google Books API の API キー（無いと 1 日の上限に当たりやすい）
VITE_GOOGLE_BOOKS_API_KEY=
# ローカル開発で Firebase エミュレータに接続する場合は true
VITE_USE_EMULATORS=false
